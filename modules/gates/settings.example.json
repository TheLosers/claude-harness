{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/claude-harness/modules/gates/hooks/bash-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/claude-harness/modules/gates/hooks/edit-guard.sh\""
          }
        ]
      }
    ]
  }
}
